# Пример настроек агента (T11). Скопируйте в .env или задайте переменные окружения.
# Файл ничего не читает сам: значения берутся из окружения (export ...).

# Адрес OpenAI-совместимого сервера модели (например, vLLM) и имя модели.
# Какая модель основная, пока не решено: выбор замером (стек-документ, раздел 2).
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=
LLM_API_KEY=EMPTY

# PostgreSQL для боевого режима (в демо-режиме не нужен).
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Папка, относительно которой открываются clip_path из базы (по умолчанию корень проекта).
# CLIPS_ROOT=/path/to/clips

# EMBEDDER=hashing включает ТЕСТОВЫЙ эмбеддер для демо. Не задавайте в боевом режиме:
# тогда search_descriptions использует BGE-M3.
# EMBEDDER=hashing
